# Copy to .env (gitignored) and fill in. Never commit real values.

# --- Microsoft Graph ---
# delegated (default): watch your own presence. Run `npm run login` once; tokens go to TOKEN_FILE (gitignored).
#   The app registration needs delegated Presence.Read (admin-consented) and "Allow public client flows" = Yes.
# app: watch WATCH_USERS with client credentials. Needs application Presence.Read.All + User.Read.All and a secret.
GRAPH_AUTH=delegated
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
TOKEN_FILE=.token.json
# app mode only:
GRAPH_CLIENT_SECRET=
# Comma-separated UPNs, emails or Entra object ids.
WATCH_USERS=

# Seconds between presence polls (minimum 5).
POLL_SECONDS=30

# --- Stack light (optional; leave MQTT_URL empty for no light) ---
# Plain MQTT only. The light follows the first watched person.
MQTT_URL=
MQTT_USER=
MQTT_PASSWORD=
# Defaults to status-master-<hostname>; must be unique on the broker.
MQTT_CLIENT_ID=
# The light's {project}/{client}/{site}/{role}/command topic.
LIGHT_TOPIC=

# Light command per state (ClearCoreStackLight 2.3 format, items joined by ;). Defaults shown.
#   NAME[,MODE]                 RED GREEN BLUE YELLOW ... at full brightness
#   IOn=PERCENT[,MODE]          one light output, e.g. IO5=26 (balance a bright green LED)
#   STRIP[[n]|[a-b]]=R,G,B[,WW,CW][,MODE]   strip pixels in percent, e.g. STRIP=100,40,0 (yellow)
#   MODE: ON (default), OFF, SLOW, FAST
# e.g. LIGHT_AWAY=IO4=100;IO5=26;STRIP=100,40,0
# LIGHT_STALE is shown when presence can't be read for STALE_SECONDS, when status-master stops, and as its Last Will.
#LIGHT_AVAILABLE=GREEN
#LIGHT_BUSY=RED
#LIGHT_DND=RED,SLOW
#LIGHT_AWAY=YELLOW
#LIGHT_OFFLINE=OFF
#LIGHT_UNKNOWN=OFF
#LIGHT_STALE=OFF
# Default: the larger of 300 and 3 x POLL_SECONDS.
#STALE_SECONDS=300

# --- Deployment (scripts/deploy.sh) ---
# The Docker host, over SSH.
#DEPLOY_HOST=user@dockerhost
# Time zone for the log, e.g. America/Chicago (default UTC).
#TZ=
